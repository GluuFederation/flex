#!/bin/sh
set +e

case "$PWD" in
  */admin-ui) ;;
  *) cd admin-ui || exit 1 ;;
esac

# --- Require signed commits ---
# A pre-commit hook cannot see the `-S` flag, so this gate only checks that
# signing is *possible*: either it is automatic (commit.gpgsign=true) or a key
# is configured for an explicit `git commit -S`. The pre-push hook verifies the
# signature that actually landed on each commit.
GPGSIGN=$(git config --get commit.gpgsign 2>/dev/null | tr '[:upper:]' '[:lower:]')
SIGNINGKEY=$(git config --get user.signingkey 2>/dev/null)
if [ "$GPGSIGN" != "true" ] && [ -z "$SIGNINGKEY" ]; then
  echo "❌ Signed commit is required."
  echo ""
  echo "   No signing key is configured. To fix, either:"
  echo "     git config user.signingkey <your-key-id>   # then: git commit -S -s -m \"<message>\""
  echo "     git config commit.gpgsign true             # or sign every commit automatically"
  echo ""
  echo "💥 Commit blocked."
  exit 1
fi

# All staged files matching prettier-supported extensions that still exist on disk
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^admin-ui/.*\.(js|jsx|ts|tsx|json|css|scss|md)$' \
  | sed 's|^admin-ui/||' \
  | while read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done)

# JS/TS subset for ESLint (json/css/scss/md are not lintable)
STAGED_SCRIPT_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx)$' || true)

# Markdown subset for markdownlint
STAGED_MD_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E '\.md$' || true)

if [ -z "$STAGED_FILES" ] && [ -z "$STAGED_SCRIPT_FILES" ]; then
  echo "✅ No checkable files staged."
  exit 0
fi

CPUS=$(nproc 2>/dev/null || sysctl -n hw.logicalcpu 2>/dev/null || echo 4)

# Call the local binaries directly: `npx` re-resolves the package on every call,
# which costs ~0.2s a time and dominates the run once it is paid per file.
BIN=./node_modules/.bin
CACHE_DIR=node_modules/.cache
mkdir -p "$CACHE_DIR"

FILE_COUNT=$(printf '%s\n' "$STAGED_FILES" | grep -c . || true)
SCRIPT_COUNT=$(printf '%s\n' "$STAGED_SCRIPT_FILES" | grep -c . || true)
MD_COUNT=$(printf '%s\n' "$STAGED_MD_FILES" | grep -c . || true)
FILE_COUNT=${FILE_COUNT:-0}
SCRIPT_COUNT=${SCRIPT_COUNT:-0}
MD_COUNT=${MD_COUNT:-0}

echo "🔍 Running prettier / eslint / deprecations / tsc / markdownlint in parallel across $CPUS workers..."

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

PRETTIER_OUT="$TMP_DIR/prettier.txt"
ESLINT_OUT="$TMP_DIR/eslint.txt"
TSC_OUT="$TMP_DIR/tsc.txt"
MDLINT_OUT="$TMP_DIR/mdlint.txt"
DEPRECATED_OUT="$TMP_DIR/deprecated.txt"

# --- Prettier: fan staged files across $CPUS parallel processes ---
# Writes one line per offending file: "<file>\t<hunk-count>"
run_prettier() {
  if [ "$FILE_COUNT" -eq 0 ]; then return 0; fi
  OFFENDERS="$TMP_DIR/prettier_offenders.txt"
  PRETTIER_ERRORS="$TMP_DIR/prettier_errors.txt"
  printf '%s\n' "$STAGED_FILES" | tr '\n' '\0' | \
    xargs -0 "$BIN/prettier" --list-different > "$OFFENDERS" 2> "$PRETTIER_ERRORS"
  # Files prettier cannot parse are reported on stderr as "[error] <file>: ..."
  # and never reach stdout, so fold them into the offender list or they'd pass.
  sed -n 's/^\[error\] \([^:]*\):.*/\1/p' "$PRETTIER_ERRORS" | sort -u >> "$OFFENDERS"
  if [ ! -s "$OFFENDERS" ]; then return 0; fi
  : > "$PRETTIER_OUT"
  while read -r file; do
    [ -z "$file" ] && continue
    TMP_FORMATTED=$(mktemp)
    if ! "$BIN/prettier" "$file" > "$TMP_FORMATTED" 2>/dev/null; then
      printf "%s\t1\n" "$file" >> "$PRETTIER_OUT"
      rm -f "$TMP_FORMATTED"
      continue
    fi
    HUNKS=$(diff "$file" "$TMP_FORMATTED" 2>/dev/null | grep -cE "^[0-9]+(,[0-9]+)?[acd][0-9]+" || true)
    [ -z "$HUNKS" ] || [ "$HUNKS" -eq 0 ] && HUNKS=1
    printf "%s\t%s\n" "$file" "$HUNKS" >> "$PRETTIER_OUT"
    rm -f "$TMP_FORMATTED"
  done < "$OFFENDERS"
  return 1
}

# --- ESLint: one process, results cached between runs ---
run_eslint() {
  if [ "$SCRIPT_COUNT" -eq 0 ]; then return 0; fi
  printf '%s\n' "$STAGED_SCRIPT_FILES" | tr '\n' '\0' | \
    xargs -0 "$BIN/eslint" --max-warnings=0 \
      --cache --cache-location "$CACHE_DIR/eslint-precommit" > "$ESLINT_OUT" 2>&1
  return $?
}

# --- Deprecated APIs: type-aware ESLint pass over staged JS/TS files ---
run_deprecation_check() {
  if [ "$SCRIPT_COUNT" -eq 0 ]; then return 0; fi
  printf '%s\n' "$STAGED_SCRIPT_FILES" | tr '\n' '\0' | \
    xargs -0 "$BIN/eslint" --no-config-lookup -c eslint.deprecation.cjs --no-warn-ignored \
      --cache --cache-location "$CACHE_DIR/eslint-deprecation" > "$DEPRECATED_OUT" 2>&1
  return $?
}

# --- TypeScript: whole-project check (can't be per-file) ---
run_tsc() {
  "$BIN/tsc" --noEmit --incremental \
    --tsBuildInfoFile "$CACHE_DIR/tsc-precommit.tsbuildinfo" > "$TSC_OUT" 2>&1
}

# --- markdownlint-cli2: run on staged .md files only ---
run_mdlint() {
  if [ "$MD_COUNT" -eq 0 ]; then return 0; fi
  printf '%s\n' "$STAGED_MD_FILES" | tr '\n' '\0' | \
    xargs -0 "$BIN/markdownlint-cli2" > "$MDLINT_OUT" 2>&1
  return $?
}

# Launch all five simultaneously
run_prettier           & PID_PRETTIER=$!
run_eslint             & PID_ESLINT=$!
run_deprecation_check  & PID_DEPRECATED=$!
run_tsc                & PID_TSC=$!
run_mdlint             & PID_MDLINT=$!

wait $PID_PRETTIER;   EXIT_PRETTIER=$? || true
wait $PID_ESLINT;     EXIT_ESLINT=$? || true
wait $PID_DEPRECATED; EXIT_DEPRECATED=$? || true
wait $PID_TSC;        EXIT_TSC=$? || true
wait $PID_MDLINT;     EXIT_MDLINT=$? || true

# --- Format per-tool output ---

# Prettier — input file is already "<file>\t<count>"
print_prettier_failures() {
  if [ ! -s "$PRETTIER_OUT" ]; then return; fi
  while IFS="	" read -r f count; do
    [ -z "$f" ] && continue
    printf "  %s (%s)\n" "$f" "$count"
  done < "$PRETTIER_OUT"
  echo ""
  echo "❌ Prettier — formatting issues"
}

# ESLint default (stylish) format:
#   /abs/path/file.ts
#     1:7  error  message  rule
#     2:1  error  message  rule
#   <blank>
print_eslint_failures() {
  if [ ! -s "$ESLINT_OUT" ]; then return; fi
  REPO_ROOT=$(pwd)
  awk -v root="$REPO_ROOT/" '
    /^\// && /\.(js|jsx|ts|tsx)$/ {
      file = $0
      sub("^" root, "", file)
      counts[file] = 0
      order[++n] = file
      next
    }
    /^[[:space:]]+[0-9]+:[0-9]+/ {
      if (file != "") counts[file]++
      next
    }
    /^$/ { file = "" }
    END {
      for (i = 1; i <= n; i++) {
        f = order[i]
        if (counts[f] > 0) printf "  %s (%d)\n", f, counts[f]
      }
    }
  ' "$ESLINT_OUT"
  echo ""
  echo "❌ ESLint — lint errors"
}

# Deprecation pass uses the same stylish format as ESLint
print_deprecated_failures() {
  if [ ! -s "$DEPRECATED_OUT" ]; then return; fi
  REPO_ROOT=$(pwd)
  awk -v root="$REPO_ROOT/" '
    /^\// && /\.(js|jsx|ts|tsx)$/ {
      file = $0
      sub("^" root, "", file)
      counts[file] = 0
      order[++n] = file
      next
    }
    /^[[:space:]]+[0-9]+:[0-9]+/ {
      if (file != "") counts[file]++
      next
    }
    /^$/ { file = "" }
    END {
      for (i = 1; i <= n; i++) {
        f = order[i]
        if (counts[f] > 0) printf "  %s (%d)\n", f, counts[f]
      }
    }
  ' "$DEPRECATED_OUT"
  echo ""
  echo "❌ Deprecations — deprecated APIs in use"
}

# tsc output: "<file>(line,col): error TSnnnn: message"
print_tsc_failures() {
  if [ ! -s "$TSC_OUT" ]; then return; fi
  awk -F'[(]' '
    /\([0-9]+,[0-9]+\): error/ { counts[$1]++ }
    END {
      for (f in counts) printf "  %s (%d)\n", f, counts[f]
    }
  ' "$TSC_OUT" | sort
  echo ""
  echo "❌ TypeScript — type errors"
}

# markdownlint-cli2 output: "<file>:line[:col] error MDxxxx/rule message"
# (older releases omit the "error" word, so both shapes are matched)
print_mdlint_failures() {
  if [ ! -s "$MDLINT_OUT" ]; then return; fi
  awk -F: '
    /:[0-9]+:[0-9]+ (error )?MD[0-9]+\// { counts[$1]++; next }
    /:[0-9]+ (error )?MD[0-9]+\// { counts[$1]++ }
    END {
      for (f in counts) printf "  %s (%d)\n", f, counts[f]
    }
  ' "$MDLINT_OUT" | sort
  echo ""
  echo "❌ Markdown — markdownlint errors"
}

echo ""

if [ $EXIT_PRETTIER -eq 0 ]; then
  echo "✅ Prettier   : no formatting errors"
else
  print_prettier_failures
fi

echo ""

if [ $EXIT_ESLINT -eq 0 ]; then
  echo "✅ ESLint     : no lint errors or warnings"
else
  print_eslint_failures
fi

echo ""

if [ "$SCRIPT_COUNT" -eq 0 ]; then
  echo "✅ Deprecations : no JS/TS files staged"
elif [ $EXIT_DEPRECATED -eq 0 ]; then
  echo "✅ Deprecations : no deprecated APIs in use"
else
  print_deprecated_failures
fi

echo ""

if [ $EXIT_TSC -eq 0 ]; then
  echo "✅ TypeScript : no type errors"
else
  print_tsc_failures
fi

echo ""

if [ "$MD_COUNT" -eq 0 ]; then
  echo "✅ Markdown   : no .md files staged"
elif [ $EXIT_MDLINT -eq 0 ]; then
  echo "✅ Markdown   : no markdownlint errors"
else
  print_mdlint_failures
fi

if [ $EXIT_PRETTIER -ne 0 ] || [ $EXIT_ESLINT -ne 0 ] || [ $EXIT_DEPRECATED -ne 0 ] ||
   [ $EXIT_TSC -ne 0 ] || [ $EXIT_MDLINT -ne 0 ]; then
  echo ""
  echo "💥 Commit blocked. Fix the errors above and try again."
  exit 1
fi

echo ""
echo "✅ All checks passed — committing."
